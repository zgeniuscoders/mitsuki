{
  "name": "mitsuki/mitsuki",
  "description": "A simple and fast PHP framework form small projects and microservices\"",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Mitsuki\\Mitsuki\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "zgeniusecoders",
      "email": "zgeniusecoders@gmail.com"
    }
  ],
  "require": {
    "php-di/php-di": "^7.1",
    "symfony/routing": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/filesystem": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/event-dispatcher": "^8.0",
    "symfony/http-client": "^8.0",
    "mitsuki/http": "^1.0",
    "mitsuki/contracts": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
